---
import CoverPlaceholder from './CoverPlaceholder.astro';

interface Material {
  id: string;
  titulo: string;
  descricao: string;
  categorias: string[];
  arquivo: string;
  imagem: string;
  destaque: boolean;
  tags: string[];
}

interface Props {
  material: Material;
  categoria: string;
}

const { material, categoria } = Astro.props;
const buscaTexto = [material.titulo, material.descricao, ...material.categorias, ...material.tags]
  .join(' ')
  .toLowerCase()
  .normalize('NFD')
  .replace(/[\u0300-\u036f]/g, '');
---
<a
  class:list={['card', { destaque: material.destaque }]}
  href={`/ler/${material.id}/`}
  data-card
  data-categoria={categoria}
  data-busca={buscaTexto}
>
  <div class="card-cover">
    {material.imagem
      ? <img src={material.imagem} alt={material.titulo} loading="lazy" />
      : <CoverPlaceholder categoria={categoria} />
    }
  </div>
  <div class="card-body">
    <div class="card-categoria">{categoria}</div>
    <h3 class="card-titulo">{material.titulo}</h3>
    <p class="card-descricao">{material.descricao}</p>
    <span class="card-cta">Ler material →</span>
  </div>
</a>
