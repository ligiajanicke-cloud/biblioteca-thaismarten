---
interface Props {
  categoria: string;
}

const { categoria } = Astro.props;
---
<svg viewBox="0 0 300 300" preserveAspectRatio="xMidYMid slice" role="img" aria-label={`Produto · ${categoria}`}>
  <rect x="0" y="0" width="300" height="300" fill="var(--panel)" />
  <text
    x="150" y="185" text-anchor="middle"
    font-family="Lora, Georgia, serif"
    font-size="150"
    fill="var(--gold-soft)"
    opacity="0.5"
  >◇</text>
  <rect x="14" y="14" width="272" height="272" fill="none" stroke="var(--gold-soft)" stroke-width="1" />
  <g transform="translate(150,138)" fill="var(--gold)">
    <line x1="-34" y1="0" x2="-10" y2="0" stroke="var(--gold-soft)" stroke-width="1" />
    <text x="0" y="4" text-anchor="middle" font-family="Lora, Georgia, serif" font-size="13">◇</text>
    <line x1="10" y1="0" x2="34" y2="0" stroke="var(--gold-soft)" stroke-width="1" />
  </g>
  <text
    x="150" y="171" text-anchor="middle"
    font-family="Poppins, Arial, sans-serif"
    font-size="10"
    fill="var(--gold-deep)"
    style="letter-spacing:2.4px; text-transform:uppercase;"
  >{categoria}</text>
  <text
    x="150" y="222" text-anchor="middle"
    font-family="Poppins, Arial, sans-serif"
    font-size="8"
    fill="var(--muted)"
    style="letter-spacing:1.6px; text-transform:uppercase;"
  >Foto em breve</text>
</svg>
