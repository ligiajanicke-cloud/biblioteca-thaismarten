---
import { getYouTubeId, getYouTubeThumbnail } from '../utils/youtube';

interface Video {
  id: string;
  titulo: string;
  descricao: string;
  categorias: string[];
  youtubeUrl: string;
  destaque: boolean;
  tags: string[];
}

interface Props {
  video: Video;
  categoria: string;
}

const { video, categoria } = Astro.props;
const ytId = getYouTubeId(video.youtubeUrl);
const thumb = getYouTubeThumbnail(video.youtubeUrl);
const buscaTexto = [video.titulo, video.descricao, ...video.categorias, ...video.tags]
  .join(' ')
  .toLowerCase()
  .normalize('NFD')
  .replace(/[\u0300-\u036f]/g, '');
---
<button
  type="button"
  class:list={['card', 'video-card', { destaque: video.destaque }]}
  data-card
  data-categoria={categoria}
  data-busca={buscaTexto}
  data-video-id={ytId}
  data-video-title={video.titulo}
>
  <div class="card-cover">
    <img src={thumb} alt={video.titulo} loading="lazy" />
    <span class="play-badge" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg>
    </span>
  </div>
  <div class="card-body">
    <div class="card-categoria">{categoria}</div>
    <h3 class="card-titulo">{video.titulo}</h3>
    <p class="card-descricao">{video.descricao}</p>
    <span class="card-cta">Assistir ▶</span>
  </div>
</button>
