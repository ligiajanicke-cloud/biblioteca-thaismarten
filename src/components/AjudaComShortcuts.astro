---
const ITENS = [
  {
    label: 'Por onde começo?',
    categoria: 'Comece aqui',
    icon: 'bussola',
  },
  {
    label: 'Vou comer fora',
    href: '/ler/guia-refeicoes-fora-e-viagem/',
    icon: 'talher',
  },
  {
    label: 'Vou viajar',
    href: '/ler/guia-refeicoes-fora-e-viagem/',
    icon: 'aviao',
  },
  {
    label: 'Preciso escolher um produto',
    categoria: 'Produtos indicados',
    icon: 'sacola',
  },
  {
    label: 'Quero consultar equivalências',
    categoria: 'Te auxilia no dia a dia',
    item: 'equivalencia-proteica-com-caseina-a1',
    icon: 'balanca',
  },
  {
    label: 'Tenho orientação Low FODMAP',
    categoria: 'Saúde intestinal',
    item: 'guia-low-fodmap',
    icon: 'folha',
  },
  {
    label: 'Vou coletar um exame',
    categoria: 'Exames de precisão',
    icon: 'gota',
  },
  {
    label: 'Preciso tirar minhas medidas',
    href: '/ler/guia-de-medidas/',
    icon: 'regua',
  },
] as const;

const ICONES: Record<string, string> = {
  bussola: '<circle cx="12" cy="12" r="9"></circle><path d="M14.5 9.5l-2 5-3-1.5 2-5z"></path>',
  talher: '<path d="M7 2v8a2 2 0 0 0 2 2v10"></path><path d="M7 2v6"></path><path d="M11 2v6"></path><path d="M17 2c-1.5 2-1.5 6 0 8s1.5 8 1.5 12"></path>',
  aviao: '<path d="M2 12l9-2 5-8 2 1-3 8 5 1v2l-5 1 3 8-2 1-5-8-9-2z"></path>',
  sacola: '<path d="M6 8h12l1 12a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L6 8z"></path><path d="M9 8V6a3 3 0 0 1 6 0v2"></path>',
  balanca: '<path d="M12 3v18"></path><path d="M5 21h14"></path><path d="M5 7l-3 6a3 3 0 0 0 6 0z"></path><path d="M19 7l-3 6a3 3 0 0 0 6 0z"></path><path d="M5 7h14"></path>',
  folha: '<path d="M5 19c9-1 13-6 14-14-8 1-13 5-14 14z"></path><path d="M6 18c2-3 4-5 8-8"></path>',
  gota: '<path d="M12 2s7 8 7 13a7 7 0 0 1-14 0c0-5 7-13 7-13z"></path>',
  regua: '<path d="M3 8h18v8H3z"></path><path d="M7 8v3"></path><path d="M11 8v3"></path><path d="M15 8v3"></path>',
};
---
<section class="ajuda-com wrap" id="ajuda-com">
  <div class="section-title">
    <h2>Preciso de ajuda com...</h2>
  </div>
  <div class="ajuda-com-grid">
    {ITENS.map((item) => {
      const Tag = 'href' in item ? 'a' : 'button';
      const attrs = 'href' in item
        ? { href: item.href }
        : {
            type: 'button',
            'data-ir-para-categoria': item.categoria,
            ...('item' in item ? { 'data-ir-para-item': item.item } : {}),
          };
      return (
        <Tag class="ajuda-com-item" {...attrs}>
          <svg class="ajuda-com-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONES[item.icon]} />
          <span class="ajuda-com-label">{item.label}</span>
        </Tag>
      );
    })}
  </div>
</section>
