---
interface Props {
  categoria: string;
}

const { categoria } = Astro.props;
---
<svg viewBox="0 0 300 400" preserveAspectRatio="xMidYMid slice" role="img" aria-label={`Material · ${categoria}`}>
  <rect x="0" y="0" width="300" height="400" fill="var(--panel)" />
  <text
    x="150" y="230" text-anchor="middle"
    font-family="Lora, Georgia, serif"
    font-size="190"
    fill="var(--gold-soft)"
    opacity="0.5"
  >◇</text>
  <rect x="14" y="14" width="272" height="372" fill="none" stroke="var(--gold-soft)" stroke-width="1" />
  <g transform="translate(150,178)" fill="var(--gold)">
    <line x1="-34" y1="0" x2="-10" y2="0" stroke="var(--gold-soft)" stroke-width="1" />
    <text x="0" y="4" text-anchor="middle" font-family="Lora, Georgia, serif" font-size="13">◇</text>
    <line x1="10" y1="0" x2="34" y2="0" stroke="var(--gold-soft)" stroke-width="1" />
  </g>
  <text
    x="150" y="211" text-anchor="middle"
    font-family="Poppins, Arial, sans-serif"
    font-size="10.5"
    fill="var(--gold-deep)"
    style="letter-spacing:2.6px; text-transform:uppercase;"
  >{categoria}</text>
</svg>
