---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import SearchBar from '../components/SearchBar.astro';
import CategoryFilters from '../components/CategoryFilters.astro';
import MaterialCard from '../components/MaterialCard.astro';
import VideoCard from '../components/VideoCard.astro';
import VideoModal from '../components/VideoModal.astro';
import SupplementCard from '../components/SupplementCard.astro';
import Footer from '../components/Footer.astro';
import materiais from '../data/materiais.json';
import videos from '../data/videos.json';
import suplementos from '../data/suplementos.json';

const ORDEM_CATEGORIAS = [
  'Comece aqui',
  'Te auxilia no dia a dia',
  'Suplementação',
  'Saúde intestinal',
  'Receitas',
  'Exames de precisão',
];

const categoriasEncontradas = new Set<string>([
  ...materiais.flatMap((m) => m.categorias),
  ...videos.flatMap((v) => v.categorias),
  'Suplementação',
]);

const categorias = [
  ...ORDEM_CATEGORIAS.filter((c) => categoriasEncontradas.has(c)),
  ...[...categoriasEncontradas].filter((c) => !ORDEM_CATEGORIAS.includes(c)).sort(),
];

const destaques = materiais.filter((m) => m.destaque);
const videosOrdenados = [...videos].sort((a, b) => Number(b.destaque) - Number(a.destaque));
---
<Layout title="Biblioteca do Paciente · Dra. Thais Marten">
  <Header />
  <SearchBar />
  <CategoryFilters categorias={categorias} />

  <main class="wrap">
    {destaques.length > 0 && (
      <section class="section" id="secao-destaques">
        <div class="section-title">
          <span class="eyebrow">◇ Em destaque</span>
        </div>
        <div class="destaque-grid">
          {destaques.map((material) => <MaterialCard material={material} categoria={material.categorias[0]} />)}
        </div>
      </section>
    )}

    {categorias.map((categoria) => {
      if (categoria === 'Exames de precisão') {
        const videosDaCategoria = videosOrdenados.filter((v) => v.categorias.includes(categoria));
        if (videosDaCategoria.length === 0) return null;
        return (
          <section class="section categoria-section" data-categoria-secao={categoria}>
            <div class="section-title stack">
              <span class="eyebrow">◇ {categoria}</span>
              <h2>Tutoriais para Coleta de Exames de Precisão</h2>
            </div>
            <div class="grid">
              {videosDaCategoria.map((video) => <VideoCard video={video} categoria={categoria} />)}
            </div>
          </section>
        );
      }

      if (categoria === 'Suplementação') {
        return (
          <section class="section categoria-section" data-categoria-secao={categoria}>
            <div class="section-title stack">
              <span class="eyebrow">◇ {categoria}</span>
              <h2>Suplementos e Produtos Recomendados</h2>
            </div>
            {suplementos.map((grupo) => (
              <div class="subsecao">
                <div class="section-title">
                  <span class="eyebrow">◇ {grupo.secao}</span>
                </div>
                <div class="grid">
                  {grupo.itens.map((item) => (
                    <SupplementCard item={item} estrategico={grupo.secao === 'Estratégicos'} />
                  ))}
                </div>
              </div>
            ))}
          </section>
        );
      }

      const materiaisDaCategoria = materiais.filter((m) => m.categorias.includes(categoria));
      if (materiaisDaCategoria.length === 0) return null;
      return (
        <section class="section categoria-section" data-categoria-secao={categoria}>
          <div class="section-title">
            <span class="eyebrow">◇ {categoria}</span>
          </div>
          <div class="grid">
            {materiaisDaCategoria.map((material) => <MaterialCard material={material} categoria={categoria} />)}
          </div>
        </section>
      );
    })}

    <p class="empty-state" id="estado-vazio-geral" hidden>
      Nenhum material encontrado com esses filtros.
    </p>
  </main>

  <Footer />
  <VideoModal />

  <script>
    const input = document.querySelector<HTMLInputElement>('#busca-input');
    const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
    const cards = document.querySelectorAll<HTMLElement>('[data-card]');
    const destaquesSection = document.querySelector<HTMLElement>('#secao-destaques');
    const categoriaSections = document.querySelectorAll<HTMLElement>('.categoria-section');
    const estadoVazioGeral = document.querySelector<HTMLElement>('#estado-vazio-geral');

    let categoriaAtiva: string | null = null;

    function normalizar(texto: string) {
      return texto.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    }

    function aplicarFiltros() {
      const termo = normalizar((input?.value ?? '').trim().toLowerCase());

      cards.forEach((card) => {
        const buscaOk = termo === '' || (card.dataset.busca ?? '').includes(termo);
        card.hidden = !buscaOk;
      });

      let algumaSecaoVisivel = false;

      categoriaSections.forEach((section) => {
        const categoriaSecao = section.dataset.categoriaSecao ?? '';
        const filtroOk = categoriaAtiva === null || categoriaAtiva === categoriaSecao;
        const temVisivel = Array.from(section.querySelectorAll<HTMLElement>('[data-card]')).some(
          (c) => !c.hidden
        );
        const mostrar = filtroOk && temVisivel;
        section.hidden = !mostrar;
        if (mostrar) algumaSecaoVisivel = true;
      });

      if (estadoVazioGeral) estadoVazioGeral.hidden = algumaSecaoVisivel;

      if (destaquesSection) {
        destaquesSection.hidden = termo !== '' || categoriaAtiva !== null;
      }
    }

    input?.addEventListener('input', aplicarFiltros);

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const alvo = chip.dataset.filtro ?? '';
        categoriaAtiva = categoriaAtiva === alvo ? null : alvo;
        chips.forEach((c) => c.classList.toggle('active', c.dataset.filtro === categoriaAtiva));
        aplicarFiltros();
      });
    });

    const modal = document.querySelector<HTMLElement>('#video-modal');
    const modalFrame = document.querySelector<HTMLElement>('#video-modal-frame');
    const modalTitle = document.querySelector<HTMLElement>('#video-modal-title');
    let ultimoFoco: HTMLElement | null = null;

    function abrirVideo(videoId: string, titulo: string) {
      if (!modal || !modalFrame) return;
      ultimoFoco = document.activeElement as HTMLElement | null;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;
      iframe.title = titulo;
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      modalFrame.replaceChildren(iframe);
      if (modalTitle) modalTitle.textContent = titulo;
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      modal.querySelector<HTMLElement>('.video-modal-close')?.focus();
    }

    function fecharVideo() {
      if (!modal || !modalFrame) return;
      modal.hidden = true;
      modalFrame.replaceChildren();
      document.body.style.overflow = '';
      ultimoFoco?.focus();
    }

    document.querySelectorAll<HTMLElement>('[data-video-id]').forEach((card) => {
      card.addEventListener('click', () => {
        const id = card.dataset.videoId;
        const titulo = card.dataset.videoTitle ?? '';
        if (id) abrirVideo(id, titulo);
      });
    });

    modal?.querySelectorAll<HTMLElement>('[data-close-modal]').forEach((el) => {
      el.addEventListener('click', fecharVideo);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.hidden) fecharVideo();
    });
  </script>
</Layout>
