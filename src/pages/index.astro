---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import SearchBar from '../components/SearchBar.astro';
import CategoryFilters from '../components/CategoryFilters.astro';
import MaterialCard from '../components/MaterialCard.astro';
import VideoCard from '../components/VideoCard.astro';
import VideoModal from '../components/VideoModal.astro';
import SupplementCard from '../components/SupplementCard.astro';
import InstallBanner from '../components/InstallBanner.astro';
import AjudaComShortcuts from '../components/AjudaComShortcuts.astro';
import HigieneSonoChecklist from '../components/HigieneSonoChecklist.astro';
import Footer from '../components/Footer.astro';
import materiais from '../data/materiais.json';
import videos from '../data/videos.json';
import suplementos from '../data/suplementos.json';
import produtosIndicados from '../data/produtos-indicados.json';
import higieneSono from '../data/higiene-sono.json';

const ORDEM_CATEGORIAS = [
  'Comece aqui',
  'Te auxilia no dia a dia',
  'Suplementação',
  'Produtos indicados',
  'Saúde intestinal',
  'Receitas',
  'Exames de precisão',
  'Higiene do sono',
];

const categoriasEncontradas = new Set<string>([
  ...materiais.flatMap((m) => m.categorias),
  ...videos.flatMap((v) => v.categorias),
  'Suplementação',
  'Produtos indicados',
  'Higiene do sono',
]);

const itensCompartilhadosProdutosIndicados = suplementos
  .flatMap((grupo) => grupo.itens)
  .filter((item) => item.categorias?.includes('Produtos indicados'));

const categorias = [
  ...ORDEM_CATEGORIAS.filter((c) => categoriasEncontradas.has(c)),
  ...[...categoriasEncontradas].filter((c) => !ORDEM_CATEGORIAS.includes(c)).sort(),
];

const destaques = materiais.filter((m) => m.destaque);
const videosOrdenados = [...videos].sort((a, b) => Number(b.destaque) - Number(a.destaque));
---
<Layout title="Biblioteca do Paciente | Dra. Thais Marten">
  <Header />
  <SearchBar />
  <CategoryFilters categorias={categorias} />
  <AjudaComShortcuts />
  <InstallBanner />

  <main class="wrap">
    {destaques.length > 0 && (
      <section class="section" id="secao-destaques">
        <div class="section-title">
          <span class="eyebrow">◇ Em destaque</span>
        </div>
        <div class="destaque-grid">
          {destaques.map((material) => <MaterialCard material={material} categoria={material.categorias[0]} />)}
        </div>
      </section>
    )}

    {categorias.map((categoria) => {
      if (categoria === 'Exames de precisão') {
        const videosDaCategoria = videosOrdenados.filter((v) => v.categorias.includes(categoria));
        if (videosDaCategoria.length === 0) return null;
        return (
          <section class="section categoria-section" data-categoria-secao={categoria}>
            <div class="section-title stack">
              <span class="eyebrow">◇ {categoria}</span>
              <h2>Tutoriais para Coleta de Exames de Precisão</h2>
            </div>
            <div class="grid">
              {videosDaCategoria.map((video) => <VideoCard video={video} categoria={categoria} />)}
            </div>
          </section>
        );
      }

      if (categoria === 'Suplementação') {
        return (
          <section class="section categoria-section" data-categoria-secao={categoria}>
            <div class="section-title stack">
              <span class="eyebrow">◇ {categoria}</span>
              <h2>Suplementos Recomendados</h2>
            </div>
            <div class="subfiltros" data-subfiltro-area={categoria}>
              <button type="button" class="subfiltro-chip" data-subfiltro-limpar>Ver todos</button>
              {['Colágenos', 'Whey', 'Beef', 'Prontos', 'Creatina', 'Eletrólitos', 'Pré-treino'].map((sub) => (
                <button type="button" class="subfiltro-chip" data-subfiltro={sub}>{sub}</button>
              ))}
            </div>
            {suplementos.map((grupo) => (
              <div class="subsecao">
                <div class="section-title">
                  <span class="eyebrow">◇ {grupo.secao}</span>
                </div>
                <div class="grid">
                  {grupo.itens.map((item) => (
                    <SupplementCard item={item} estrategico={grupo.secao === 'Estratégicos'} />
                  ))}
                </div>
              </div>
            ))}
            <p class="ultima-revisao">Última revisão: setembro/2026</p>
          </section>
        );
      }

      if (categoria === 'Produtos indicados') {
        return (
          <section class="section categoria-section" data-categoria-secao={categoria}>
            <div class="section-title stack">
              <span class="eyebrow">◇ {categoria}</span>
              <h2>Produtos Indicados para o Dia a Dia</h2>
            </div>
            <div class="subfiltros" data-subfiltro-area={categoria}>
              <button type="button" class="subfiltro-chip" data-subfiltro-limpar>Ver todos</button>
              {['Proteínas', 'Barrinhas', 'Massas', 'Pães', 'Bebidas vegetais', 'Aveias/fibras', 'Molhos', 'Chás'].map((sub) => (
                <button type="button" class="subfiltro-chip" data-subfiltro={sub}>{sub}</button>
              ))}
            </div>
            {itensCompartilhadosProdutosIndicados.length > 0 && (
              <div class="subsecao">
                <div class="section-title">
                  <span class="eyebrow">◇ Proteínas Prontas e Barrinhas</span>
                </div>
                <div class="grid">
                  {itensCompartilhadosProdutosIndicados.map((item) => (
                    <SupplementCard item={item} categoria={categoria} />
                  ))}
                </div>
              </div>
            )}
            {produtosIndicados.map((grupo) => (
              <div class="subsecao">
                <div class="section-title">
                  <span class="eyebrow">◇ {grupo.secao}</span>
                </div>
                <div class="grid">
                  {grupo.itens.map((item) => (
                    <SupplementCard item={item} categoria={categoria} />
                  ))}
                </div>
              </div>
            ))}
            <p class="ultima-revisao">Última revisão: setembro/2026</p>
          </section>
        );
      }

      if (categoria === 'Higiene do sono') {
        return (
          <section class="section categoria-section" data-categoria-secao={categoria}>
            <div class="section-title stack">
              <span class="eyebrow">◇ {categoria}</span>
              <h2>Higiene do Sono</h2>
            </div>
            <p class="page-note-inline">
              Recursos que podem auxiliar na construção de uma rotina noturna mais adequada. A indicação e o uso devem respeitar a estratégia individual de cada paciente.
            </p>
            <HigieneSonoChecklist />
            <div class="grid">
              {higieneSono.map((item) => (
                <SupplementCard item={item} categoria={categoria} />
              ))}
            </div>
          </section>
        );
      }

      const materiaisDaCategoria = materiais.filter((m) => m.categorias.includes(categoria));
      if (materiaisDaCategoria.length === 0) return null;
      return (
        <section class="section categoria-section" data-categoria-secao={categoria}>
          <div class="section-title">
            <span class="eyebrow">◇ {categoria}</span>
          </div>
          <div class="grid">
            {materiaisDaCategoria.map((material) => <MaterialCard material={material} categoria={categoria} />)}
          </div>
        </section>
      );
    })}

    <p class="empty-state" id="estado-vazio-geral" hidden>
      Nenhum material encontrado com esses filtros.
    </p>
  </main>

  <Footer />
  <VideoModal />

  <script>
    const input = document.querySelector<HTMLInputElement>('#busca-input');
    const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
    const cards = document.querySelectorAll<HTMLElement>('[data-card]');
    const destaquesSection = document.querySelector<HTMLElement>('#secao-destaques');
    const categoriaSections = document.querySelectorAll<HTMLElement>('.categoria-section');
    const estadoVazioGeral = document.querySelector<HTMLElement>('#estado-vazio-geral');

    let categoriaAtiva: string | null = null;

    function normalizar(texto: string) {
      return texto.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    }

    // Camada de sin\u00f4nimos: traduz a linguagem do paciente para os termos
    // que realmente aparecem nos materiais/produtos cadastrados. Chaves e
    // valores j\u00e1 normalizados (sem acento, min\u00fasculo).
    const SINONIMOS: Record<string, string[]> = {
      'prisao de ventre': ['constipacao'],
      'intestino preso': ['constipacao'],
      'estufada': ['distensao'],
      'estufamento': ['distensao'],
      'gases': ['distensao'],
      'proteina': ['protein', 'proteica', 'colageno', 'whey', 'beef protein', 'equivalencia proteica'],
      'leite': ['caseina'],
      'viajar': ['viagem'],
      'restaurante': ['viagem'],
      'comer fora': ['viagem'],
      'produto': ['produtos indicados'],
      'mercado': ['produtos indicados'],
      'exame': ['exames de precisao'],
      'coleta': ['exames de precisao'],
      'mounjaro': ['glp-1'],
      'tirzepatida': ['glp-1'],
    };

    function termosDeBusca(termo: string): string[] {
      const termos = new Set([termo]);
      for (const [chave, alvos] of Object.entries(SINONIMOS)) {
        if (termo.includes(chave)) alvos.forEach((alvo) => termos.add(alvo));
      }
      return [...termos];
    }

    const subfiltroAtivoPorArea: Record<string, string | null> = {};

    document.querySelectorAll<HTMLElement>('[data-subfiltro-area]').forEach((area) => {
      const nomeArea = area.dataset.subfiltroArea ?? '';
      subfiltroAtivoPorArea[nomeArea] = null;
      const botoesArea = area.querySelectorAll<HTMLButtonElement>('.subfiltro-chip');
      botoesArea.forEach((botao) => {
        botao.addEventListener('click', () => {
          if (botao.hasAttribute('data-subfiltro-limpar')) {
            subfiltroAtivoPorArea[nomeArea] = null;
          } else {
            const alvo = botao.dataset.subfiltro ?? '';
            subfiltroAtivoPorArea[nomeArea] = subfiltroAtivoPorArea[nomeArea] === alvo ? null : alvo;
          }
          botoesArea.forEach((b) => {
            b.classList.toggle(
              'active',
              !b.hasAttribute('data-subfiltro-limpar') && b.dataset.subfiltro === subfiltroAtivoPorArea[nomeArea]
            );
          });
          aplicarFiltros();
        });
      });
    });

    function aplicarFiltros() {
      const termoBruto = normalizar((input?.value ?? '').trim().toLowerCase());
      const termos = termoBruto === '' ? [] : termosDeBusca(termoBruto);

      cards.forEach((card) => {
        const busca = card.dataset.busca ?? '';
        const buscaOk = termoBruto === '' || termos.some((t) => busca.includes(t));

        const areaDoCard = card.dataset.categoria ?? '';
        const subfiltroAtivo = subfiltroAtivoPorArea[areaDoCard] ?? null;
        const subcategorias = (card.dataset.subcategorias ?? '').split(',').filter(Boolean);
        const subfiltroOk = !subfiltroAtivo || subcategorias.includes(subfiltroAtivo);

        card.hidden = !(buscaOk && subfiltroOk);
      });

      let algumaSecaoVisivel = false;

      categoriaSections.forEach((section) => {
        const categoriaSecao = section.dataset.categoriaSecao ?? '';
        const filtroOk = categoriaAtiva === null || categoriaAtiva === categoriaSecao;
        const temVisivel = Array.from(section.querySelectorAll<HTMLElement>('[data-card]')).some(
          (c) => !c.hidden
        );
        const mostrar = filtroOk && temVisivel;
        section.hidden = !mostrar;
        if (mostrar) algumaSecaoVisivel = true;
      });

      if (estadoVazioGeral) estadoVazioGeral.hidden = algumaSecaoVisivel;

      if (destaquesSection) {
        destaquesSection.hidden = termoBruto !== '' || categoriaAtiva !== null;
      }
    }

    input?.addEventListener('input', aplicarFiltros);

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const alvo = chip.dataset.filtro ?? '';
        categoriaAtiva = categoriaAtiva === alvo ? null : alvo;
        chips.forEach((c) => c.classList.toggle('active', c.dataset.filtro === categoriaAtiva));
        aplicarFiltros();
      });
    });

    document.querySelectorAll<HTMLElement>('[data-ir-para-categoria]').forEach((botao) => {
      botao.addEventListener('click', () => {
        const alvo = botao.dataset.irParaCategoria ?? '';
        if (categoriaAtiva !== alvo) {
          const chip = Array.from(chips).find((c) => c.dataset.filtro === alvo);
          chip?.click();
        }
        document.querySelector(`[data-categoria-secao="${alvo}"]`)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    const modal = document.querySelector<HTMLElement>('#video-modal');
    const modalFrame = document.querySelector<HTMLElement>('#video-modal-frame');
    const modalTitle = document.querySelector<HTMLElement>('#video-modal-title');
    let ultimoFoco: HTMLElement | null = null;

    function abrirVideo(videoId: string, titulo: string) {
      if (!modal || !modalFrame) return;
      ultimoFoco = document.activeElement as HTMLElement | null;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;
      iframe.title = titulo;
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      modalFrame.replaceChildren(iframe);
      if (modalTitle) modalTitle.textContent = titulo;
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      modal.querySelector<HTMLElement>('.video-modal-close')?.focus();
    }

    function fecharVideo() {
      if (!modal || !modalFrame) return;
      modal.hidden = true;
      modalFrame.replaceChildren();
      document.body.style.overflow = '';
      ultimoFoco?.focus();
    }

    document.querySelectorAll<HTMLElement>('[data-video-id]').forEach((card) => {
      card.addEventListener('click', () => {
        const id = card.dataset.videoId;
        const titulo = card.dataset.videoTitle ?? '';
        if (id) abrirVideo(id, titulo);
      });
    });

    modal?.querySelectorAll<HTMLElement>('[data-close-modal]').forEach((el) => {
      el.addEventListener('click', fecharVideo);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.hidden) fecharVideo();
    });
  </script>
</Layout>
